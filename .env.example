# ══════════════════════════════════════════════════════════════════
# EGCHAT API - Variables de entorno
# Copia este archivo como .env y rellena los valores.
# En Render: Settings > Environment (nunca subas .env al repo).
# ══════════════════════════════════════════════════════════════════

# Puerto (Render lo asigna automáticamente)
PORT=5000

# ── Seguridad (OBLIGATORIO en producción) ─────────────────────────
# Firma de los JWT. Sin esta variable el API arranca con un secreto
# derivado de SUPABASE_SERVICE_KEY: funciona, pero rotar la clave de
# Supabase invalidaría todas las sesiones.
JWT_SECRET=cambia_esto_por_una_cadena_aleatoria_de_64_caracteres

# Clave para las rutas de administración (/api/kyc/*, /api/kyc/review,
# /api/system/dependencies). Si no se define, esas rutas quedan cerradas.
ADMIN_RESET_KEY=cambia_esto_por_otra_cadena_aleatoria

# Token de emergencia para /api/auth/emergency-reset (opcional).
# Si no se define, el endpoint responde 503.
EMERGENCY_RESET_TOKEN=

# ── Supabase ──────────────────────────────────────────────────────
# Settings > API del proyecto
SUPABASE_URL=https://TU_PROYECTO.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...TU_SERVICE_ROLE_KEY

# Clave publicable (la necesita /api/system/dependencies)
SUPABASE_ANON_KEY=

# Token de servicio para llamadas internas (integración con otros servicios)
SERVICE_TOKEN=

# Orígenes permitidos por CORS, separados por comas
CORS_ALLOWED_ORIGINS=https://egchat.app

# ── Integraciones opcionales ──────────────────────────────────────
# LIA-25 (Groq). Obligatoria para el asistente.
GROQ_API_KEY=
LIA_CHAT_MODEL=
LIA_VISION_MODEL=
LIA_STT_MODEL=

# OpenAI (fallback de LIA si no hay Groq)
OPENAI_API_KEY=

# Twilio (SMS de verificación y llamadas)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=

# Web Push (notificaciones del navegador)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# APNs / VoIP para llamadas iOS (Render). APNS_KEY_P8 lleva el contenido
# del .p8 con los saltos de línea escapados (\n).
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_KEY_P8=
APNS_BUNDLE_ID=com.egchat.nativa
APNS_ENV=production

# Umbral del libro mayor que exige aprobación manual
LEDGER_APPROVAL_THRESHOLD=

# Activar el scraping de noticias externas
ENABLE_EXTERNAL_NEWS_SCRAPING=false
